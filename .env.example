# Postgres (Neon / Supabase / any). When set, build runs migrations/0002_arcade_scores.sql
# and leaderboards use this DB. When unset, local/preview uses embedded PGLite.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional Better Auth (not required for arcade scores)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://your-arcade.vercel.app
